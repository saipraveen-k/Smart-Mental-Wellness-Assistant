# ---------------------------------------------------------------------------
# Smart Mental Wellness Assistant — environment configuration
# Copy to `.env` and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Smart Mental Wellness Assistant
LOG_LEVEL=INFO

# --- Database (MongoDB) -----------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mental_wellness
MONGODB_TIMEOUT_MS=5000

# --- Datasets (Hugging Face, dynamic loading — never local CSV fallback) ----
TEXT_DATASET_ID=SetFit/go_emotions
CV_DATASET_ID=Jeneral/fer-2013
CRISIS_DATASET_ID=av9ash/CSSR-S_labelled_suicidewatch_posts_reddit
CRISIS_CONTROL_DATASET_ID=SetFit/go_emotions
HF_DATASET_REVISION=main
HF_CACHE_DIR=

# --- Models -----------------------------------------------------------------
TEXT_MODEL_NAME=distilbert-base-uncased
# Set to a local path (e.g. ml/artifacts/text_emotion/model) to use a fine-tuned
# checkpoint instead of the base model for inference.
TEXT_MODEL_PATH=ml/artifacts/text_emotion/model
CV_MODEL_PATH=ml/artifacts/cv_emotion/model.pt
CRISIS_MODEL_PATH=ml/artifacts/crisis/model
MODEL_DEVICE=auto            # auto | cpu | cuda

# --- Multimodal fusion weights (must sum to 1.0) ----------------------------
TEXT_MODALITY_WEIGHT=0.65
VISION_MODALITY_WEIGHT=0.35

# --- Feature switches -------------------------------------------------------
ENABLE_CAMERA=true
ENABLE_FORECASTING=true
SAVE_IMAGES_BY_DEFAULT=false

# --- Forecasting ------------------------------------------------------------
FORECAST_MIN_OBSERVATIONS=10
FORECAST_HORIZON_DAYS=7

# --- Security ---------------------------------------------------------------
# REQUIRED in production. In development a random ephemeral secret is generated
# with a warning when left as CHANGE_ME.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_IMAGE_BYTES=4194304
MAX_TEXT_LENGTH=4000

# --- Safety -----------------------------------------------------------------
# ISO country code used to select crisis resources (e.g. US, GB, IN).
CRISIS_RESOURCES_COUNTRY=US
CRISIS_RESOURCES_FILE=config/crisis_resources.json

# --- Paths ------------------------------------------------------------------
ARTIFACTS_DIR=ml/artifacts

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
